{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "claims"],
  "properties": {
    "state": {"enum": ["active", "final", "withdrawn"]},
    "summary": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_refs"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["supported", "refuted", "not_established"]},
          "value": {},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    }
  }
}
