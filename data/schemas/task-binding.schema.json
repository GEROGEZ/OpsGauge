{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsGauge release task binding",
  "type": "object",
  "required": [
    "task_id",
    "task",
    "source_case_id",
    "family_id",
    "level",
    "source_level",
    "profile"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task": {
      "enum": [
        "DR",
        "AD",
        "HA",
        "RCA"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "profile": {
      "enum": [
        "shell_raw",
        "native_raw",
        "umodel_semantic"
      ]
    }
  }
}
